<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_logo" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="@color/ink" android:textSize="24sp" android:textStyle="bold" android:letterSpacing="0.12" />
                    <TextView style="@style/SmallLabel" android:text="@string/brand_chinese" android:letterSpacing="0.12" android:textSize="11sp" android:layout_marginTop="3dp" />
                </LinearLayout>
                <Button android:id="@+id/history" style="@style/QuietButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/history" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/tagline" android:textColor="@color/ink" android:textSize="28sp" android:textStyle="bold" />
            <TextView style="@style/SmallLabel" android:text="@string/subtitle" android:layout_marginTop="8dp" android:layout_marginBottom="24dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card" android:padding="18dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView style="@style/SectionLabel" android:layout_width="0dp" android:layout_weight="1" android:text="@string/text_section" />
                    <Button android:id="@+id/paste" style="@style/QuietButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/paste" />
                    <Button android:id="@+id/clear" style="@style/QuietButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/clear" />
                </LinearLayout>
                <EditText android:id="@+id/editor" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="180dp" android:maxHeight="320dp" android:gravity="top|start" android:background="@android:color/transparent"
                    android:inputType="textMultiLine|textCapSentences" android:hint="@string/editor_hint" android:textSize="17sp"
                    android:lineSpacingExtra="7dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:scrollbars="vertical"
                    android:importantForAutofill="no" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <Button android:id="@+id/sample" style="@style/QuietButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/sample_action" />
                    <TextView android:id="@+id/count" style="@style/SmallLabel" android:layout_width="0dp" android:layout_weight="1" android:gravity="end" android:text="@string/empty_count" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:background="@drawable/card" android:padding="18dp">
                <TextView style="@style/SectionLabel" android:text="@string/voice_section" android:layout_marginBottom="18dp" />
                <TextView style="@style/SmallLabel" android:text="@string/language" android:labelFor="@id/language" />
                <TextView android:id="@+id/language" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:text="@string/chinese_language" android:textSize="15sp" android:textColor="@color/ink" />
                <TextView style="@style/SmallLabel" android:text="@string/voice" android:labelFor="@id/voice" android:layout_marginTop="8dp" />
                <Spinner android:id="@+id/voice" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/select_voice" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/rate" android:textSize="14sp" android:labelFor="@id/rate" />
                    <TextView android:id="@+id/rate_value" style="@style/SmallLabel" android:text="@string/normal_multiplier" />
                </LinearLayout>
                <SeekBar android:id="@+id/rate" android:layout_width="match_parent" android:layout_height="48dp" android:max="150" android:progress="50" android:contentDescription="@string/rate_description" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/pitch" android:textSize="14sp" android:labelFor="@id/pitch" />
                    <TextView android:id="@+id/pitch_value" style="@style/SmallLabel" android:text="@string/normal_multiplier" />
                </LinearLayout>
                <SeekBar android:id="@+id/pitch" android:layout_width="match_parent" android:layout_height="48dp" android:max="150" android:progress="50" android:contentDescription="@string/pitch_description" />
                <TextView style="@style/SmallLabel" android:layout_width="match_parent" android:text="@string/engine_note" android:lineSpacingExtra="3dp" />
                <Button android:id="@+id/engine_settings" style="@style/QuietButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/engine_settings" />
            </LinearLayout>
            <TextView style="@style/SmallLabel" android:layout_width="match_parent" android:gravity="center" android:text="@string/local_draft" android:layout_marginTop="22dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="16dp" android:paddingTop="10dp">
        <TextView android:id="@+id/status" style="@style/SmallLabel" android:layout_width="match_parent" android:gravity="center" android:text="@string/engine_loading" android:accessibilityLiveRegion="polite" android:layout_marginBottom="10dp" />
        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:visibility="gone" android:layout_marginBottom="10dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/play" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:background="@drawable/button_primary" android:text="@string/play" android:textColor="#FFFFFF" android:textSize="16sp" android:textAllCaps="false" />
            <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/export" android:layout_width="108dp" android:layout_height="56dp" android:layout_marginStart="12dp" android:background="@drawable/button_secondary" android:text="@string/export" android:textColor="@color/accent" android:textSize="14sp" android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
